# Public HTTPS URL of the deployed FastAPI service. Never use localhost on a phone.
VITE_API_BASE_URL=https://api.your-domain.example

# Supabase values are required by client features that use Supabase directly.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
