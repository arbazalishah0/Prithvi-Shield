# PRITHVI SHIELD BACKEND CONFIGURATION
# Copy this file to .env and fill in your Firebase project values.

# Firebase Project Settings
FIREBASE_PROJECT_ID=prithvi-shield-demo
FIREBASE_STORAGE_BUCKET=prithvi-shield-demo.appspot.com

# Path to your Firebase service account JSON key file
# Default location is inside the credentials folder:
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Server Settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# ==============================================================================
# RUMIK AI MULTILINGUAL VOICE AGENT CONFIGURATION (PRITHVI Safety Assistant)
# ==============================================================================
# Rumik AI secret API key (NEVER expose to the frontend / client)
RUMIK_API_KEY=your_rumik_api_key_here

# Rumik AI Gateway base URL
RUMIK_GATEWAY_URL=https://silk-api.rumik.ai

# Rumik TTS model: "mulberry" (natural Indian conversational voice) or "muga" (tone tags)
RUMIK_MODEL=mulberry

# Default spoken language code ("en", "hi", "mr")
RUMIK_DEFAULT_LANGUAGE=en

# Voice Agent Session TTL in seconds (default: 900s = 15 minutes)
RUMIK_SESSION_TTL_SECONDS=900

# Rate Limiting: max sessions created per minute per IP
VOICE_SESSION_RATE_LIMIT_PER_MINUTE=20

# Maximum active concurrent sessions
VOICE_MAX_ACTIVE_SESSIONS=100

